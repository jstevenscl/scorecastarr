# ============================================================
#  ScorecastArr — Credentials
#  Copy this file to credentials.env and fill in real values.
#  credentials.env is gitignored and must NEVER be committed.
# ============================================================

# Dispatcharr connection
DISPATCHARR_URL=http://YOUR_SERVER_IP:9191
DISPATCHARR_USER=your_username
DISPATCHARR_PASS=your_password

# Dispatcharr API token (v0.20.0+, preferred over username/password)
# DISPATCHARR_API_TOKEN=your_api_token

# Stream base URL — the address Dispatcharr uses to reach this server's HLS streams
# Must be the server's LAN IP, not localhost
STREAM_BASE_URL=http://YOUR_SERVER_IP:7777
